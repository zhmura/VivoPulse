{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Processed signal CSV header 1.2",
  "description": "Validates a JSON descriptor of the CSV header, not raw CSV text or clinical validity.",
  "type": "object",
  "required": [
    "columns"
  ],
  "properties": {
    "columns": {
      "const": [
        "time_ms",
        "raw_value",
        "filtered_value",
        "is_peak",
        "r",
        "g",
        "b",
        "motion_rms",
        "saturation_fraction",
        "imu_rms_g",
        "phase_tag",
        "timestamp_ns",
        "interpolated"
      ]
    }
  },
  "additionalProperties": false
}
